# ==============================================================================
# MathCity AI — Backend Production Environment Configuration Template
# NUSXA OLING: cp .env.example .env (Hech qachon haqiqiy .env faylini commit qilmang)
# ==============================================================================

# Server Network & Mode
PORT=4000
NODE_ENV=production

# Database Connection (PostgreSQL with SSL enabled in production)
DATABASE_URL="postgresql://mathcity_user:SECURE_STRONG_DB_PASSWORD@localhost:5432/mathcity_db?schema=public&sslmode=prefer"

# Security & Authentication Tokens (Use random 32+ characters secret)
# Generatsiya qilish: openssl rand -base64 32
JWT_SECRET="replace-with-ultra-secure-random-at-least-32-chars-secret"
JWT_EXPIRES_IN="7d"

# Strict CORS Allowed Origins (Comma-separated list, no wildcard in production)
ALLOWED_ORIGINS="https://mathcity.uz,https://app.mathcity.uz,http://localhost:8085"

# Google Cloud OAuth 2.0 Client ID (Used for verifying student tokens)
GOOGLE_CLIENT_ID="1234567890-exampleapps.googleusercontent.com"

# Google Gemini AI Teacher (Ziyo) - Server-side only
GEMINI_API_KEY="AIzaSy_YOUR_SECURE_GEMINI_KEY"
AI_MODEL_NAME="gemini-1.5-flash"

# Application Metadata
APP_NAME="MathCity AI"
APP_VERSION="1.0.0"
