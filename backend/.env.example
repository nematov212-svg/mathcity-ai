# ==============================================================================
# MathCity AI — Backend Production Environment Configuration Template
# NUSXA OLING: cp .env.example .env (Hech qachon haqiqiy parollarni Git-ga qo'shmang)
# ==============================================================================

# Server Network & Mode
PORT=10000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Render Managed PostgreSQL Database
# Render ichki ulanish satri (Internal Connection String):
# DATABASE_URL="postgresql://mathcity_ai_user:password@dpg-xxxxx-a/mathcity_ai"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://mathcity_user:SECURE_STRONG_DB_PASSWORD@localhost:5432/mathcity_db?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. JWT & Security (Generatsiya: openssl rand -base64 32)
# ------------------------------------------------------------------------------
JWT_SECRET="mathcity-ai-super-secret-jwt-key-32-chars-long"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins (Vergul bilan ajratilgan ro'yxat, bo'sh joysiz)
# DIQQAT: Yangi Flutter web domain, Vercel/Netlify yoki shaxsiy domen qo'shmoqchi
# bo'lsangiz, uni shu yerga vergul bilan qo'shing. Masalan: https://my-custom-domain.com
# ------------------------------------------------------------------------------
ALLOWED_ORIGINS="https://mathcity-ai-web.onrender.com,https://mathcity-ai-admin.onrender.com,http://localhost:8085"

# ------------------------------------------------------------------------------
# 4. Google & Apple OAuth Configuration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="608766203356-d6oq3gvc5n199671ho1npgr240afkjup.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="608766203356-d6oq3gvc5n199671ho1npgr240afkjup.apps.googleusercontent.com"

APPLE_CLIENT_ID="ai.mathcity.app"
APPLE_TEAM_ID="YOUR_APPLE_TEAM_ID"
APPLE_KEY_ID="YOUR_APPLE_KEY_ID"
APPLE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 5. Offline MathCity AI Ustoz Engine (100% Offline & Rules-Based)
# Hech qanday tashqi AI/LLM API kaliti talab qilinmaydi.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 6. Object Storage for Photos & Audio (Cloudflare R2 / AWS S3 / Render)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT="https://storage.mathcity.ai"
OBJECT_STORAGE_BUCKET="mathcity-media"
OBJECT_STORAGE_ACCESS_KEY=""
OBJECT_STORAGE_SECRET_KEY=""

# ------------------------------------------------------------------------------
# 7. Application & Admin Portal
# ------------------------------------------------------------------------------
APP_NAME="MathCity AI"
APP_VERSION="1.0.0"
APP_BASE_URL="https://mathcity-ai-web.onrender.com"
ADMIN_BASE_URL="https://mathcity-ai-api.onrender.com/admin"
