datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Mode {
  KIDS
}

enum Role {
  STUDENT
}

enum SubscriptionStatus {
  FREE_TRIAL_ACTIVE
  FREE_TRIAL_EXPIRED
  PRO_ACTIVE
  PRO_EXPIRED
}

enum QuestionType {
  MULTIPLE_CHOICE
  NUMERICAL_INPUT
  FRACTION_MATCH
  EQUATION_SOLVE
  PATTERN_RECOGNITION
}

enum CoinTransactionType {
  LESSON_COMPLETE
  EXERCISE_CORRECT
  GAME_REWARD
  DAILY_TASK
  ACHIEVEMENT_REWARD
  BUILDING_PURCHASE
  SYSTEM_GRANT
  CAR_PURCHASE
  CAR_REPAIR
}

enum XPTransactionType {
  LESSON_COMPLETE
  EXERCISE_CORRECT
  GAME_REWARD
  DAILY_TASK
  ACHIEVEMENT
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String?         @unique
  usernameLower String?         @unique @map("username_lower")
  passwordHash  String?
  googleId      String?         @unique
  appleId       String?         @unique
  role          Role            @default(STUDENT)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  studentProfile     StudentProfile?
  subscription       Subscription?
  coinWallet         CoinWallet?
  studentXP          StudentXP?
  exerciseAttempts   ExerciseAttempt[]
  rewardedQuestions  RewardedQuestion[]
  lessonProgress     LessonProgress[]
  gameSessions       GameSession[]
  ownedBuildings     OwnedBuilding[]
  dailyTasks         StudentDailyTask[]
  achievements       StudentAchievement[]
  aiMessages         AIMessage[]
  aiConversations    AIConversation[]
  aiUsage            AIUsage?
  sessions           AuthSession[]
  purchaseEvents     PurchaseEvent[]
  mediaAttachments   MediaAttachment[]
  auditLogs          AdminAuditLog[]
  ownedGameCars      UserGameCar[]
  gameDriftScores    GameDriftScore[]
  dailyActivities    DailyActivity[]
  newUserDiscountUsedAt DateTime? @map("new_user_discount_used_at")
  announcementDismissals UserAnnouncementDismissal[]

  @@map("users")
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  dateOfBirth DateTime
  age         Int
  mode        Mode
  grade       Int      // 1 to 11
  avatarUrl   String?
  cityLevel   Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("student_profiles")
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          SubscriptionStatus @default(FREE_TRIAL_ACTIVE)
  trialStartedAt  DateTime           @default(now())
  trialExpiresAt  DateTime
  trialUsed       Boolean            @default(false)
  proStartedAt    DateTime?
  proExpiresAt    DateTime?
  storeOrderId    String?
  purchaseToken   String?
  platform        String?            // "google_play", "app_store", "web"
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("subscriptions")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("auth_sessions")
}

model CoinWallet {
  id           String            @id @default(uuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Int               @default(100) // 100 starting bonus for building purchase demonstration
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  transactions CoinTransaction[]

  @@map("coin_wallets")
}

model CoinTransaction {
  id             String              @id @default(uuid())
  walletId       String
  wallet         CoinWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Int                 // Positive for reward, negative for purchase
  type           CoinTransactionType
  description    String
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())

  @@map("coin_transactions")
}

model StudentXP {
  id           String          @id @default(uuid())
  userId       String          @unique
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXP      Int             @default(0)
  level        Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions XPTransaction[]

  @@map("student_xp")
}

model XPTransaction {
  id          String            @id @default(uuid())
  studentXPId String
  studentXP   StudentXP         @relation(fields: [studentXPId], references: [id], onDelete: Cascade)
  amount      Int
  type        XPTransactionType
  description String
  createdAt   DateTime          @default(now())

  @@map("xp_transactions")
}

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  gradeMin    Int
  gradeMax    Int
  mode        Mode
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]

  @@map("courses")
}

model Lesson {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  topicKey     String
  description  String
  contentMd    String
  formulaLatex String?
  rewardXP     Int      @default(50)
  rewardCoins  Int      @default(10)
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections     Section[]
  questions    Question[]
  progress     LessonProgress[]

  @@map("lessons")
}

model Section {
  id          String   @id @default(uuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String   // e.g. "1-qism", "2-qism"
  orderIndex  Int      @default(1)
  createdAt   DateTime @default(now())

  questions   Question[]

  @@map("sections")
}

model Question {
  id            String       @id @default(uuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  prompt        String
  type          QuestionType @default(MULTIPLE_CHOICE)
  optionsJson   String       // JSON array of strings
  correctAnswer String
  explanation   String
  hint          String
  formulaLatex  String?
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())

  attempts          ExerciseAttempt[]
  rewardedQuestions RewardedQuestion[]

  @@map("questions")
}

model RewardedQuestion {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  awardedAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@map("rewarded_questions")
}

model ExerciseAttempt {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  submittedAnswer String
  isCorrect       Boolean
  awardedCoins    Int      @default(0) // Exactly 1 for first time, 0 for repeats
  awardedXP       Int      @default(0)
  createdAt       DateTime @default(now())

  @@map("exercise_attempts")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean   @default(false)
  score       Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model BuildingDefinition {
  id            String          @id @default(uuid())
  key           String          @unique
  name          String
  category      String
  costInCoins   Int             @default(100) // Default 100 coins
  requiredLevel Int             @default(1)
  description   String
  iconName      String
  mode          Mode            @default(KIDS)
  createdAt     DateTime        @default(now())

  owned         OwnedBuilding[]

  @@map("building_definitions")
}

model OwnedBuilding {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingKey  String
  building     BuildingDefinition @relation(fields: [buildingKey], references: [key], onDelete: Cascade)
  gridX        Int
  gridY        Int
  isConstructed Boolean           @default(true)
  constructedAt DateTime          @default(now())

  @@unique([userId, gridX, gridY])
  @@map("owned_buildings")
}

model GameDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  title       String
  description String
  category    String
  iconName    String
  mode        Mode     @default(KIDS)
  createdAt   DateTime @default(now())

  sessions    GameSession[]

  @@map("game_definitions")
}

model GameSession {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameKey     String
  game        GameDefinition @relation(fields: [gameKey], references: [key], onDelete: Cascade)
  score       Int
  coinsEarned Int
  xpEarned    Int
  playedAt    DateTime       @default(now())

  @@map("game_sessions")
}

model DailyTask {
  id          String             @id @default(uuid())
  key         String             @unique
  title       String
  description String
  targetCount Int
  rewardCoins Int
  rewardXP    Int
  createdAt   DateTime           @default(now())

  students    StudentDailyTask[]

  @@map("daily_tasks")
}

model StudentDailyTask {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String
  task         DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  currentCount Int       @default(0)
  isCompleted  Boolean   @default(false)
  claimedAt    DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, taskId])
  @@map("student_daily_tasks")
}

model Achievement {
  id          String               @id @default(uuid())
  key         String               @unique
  title       String
  description String
  iconName    String
  rewardCoins Int
  rewardXP    Int
  createdAt   DateTime             @default(now())

  students    StudentAchievement[]

  @@map("achievements")
}

model StudentAchievement {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  achievement    Achievement @relation(fields: [achievementKey], references: [key], onDelete: Cascade)
  unlockedAt     DateTime    @default(now())

  @@unique([userId, achievementKey])
  @@map("student_achievements")
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("Matematika savoli")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String          // "user" or "assistant"
  text           String
  formulaLatex   String?
  step           Int?
  createdAt      DateTime        @default(now())

  @@map("ai_messages")
}

model AIUsage {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyUsedCount Int      @default(0)
  dailyQuota     Int      @default(20)
  totalUsedCount Int      @default(0)
  lastResetDate  String   // "YYYY-MM-DD"
  updatedAt      DateTime @updatedAt

  @@map("ai_usage")
}

model PurchaseEvent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   // "click", "payme", "apple", "google"
  transactionId  String   @unique
  amountUzs      Int
  status         String   // "PENDING", "COMPLETED", "FAILED"
  planName       String
  idempotencyKey String?  @unique
  metadata       String?  // JSON string
  createdAt      DateTime @default(now())

  @@map("purchase_events")
}

model MediaAttachment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileKey        String   @unique
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageUrl     String
  purpose        String   // "AI_IMAGE_QUESTION", "AVATAR", "VOICE_INPUT"
  createdAt      DateTime @default(now())

  @@map("media_attachments")
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String   // "CREATE_LESSON", "UPDATE_LESSON", "CHANGE_QUOTA", "BLOCK_USER"
  targetType String   // "LESSON", "USER", "SUBSCRIPTION"
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("admin_audit_logs")
}

model GameCar {
  id                String          @id @default(uuid())
  key               String          @unique
  name              String
  category          String          // supercar, muscle, drift, classic, suv, truck, hypercar, hot_hatch, electric, sedan
  priceCoins        Int             @default(0)
  maxSpeed          Int             // km/h
  acceleration      Float           // seconds (0-100) or rating
  handling          Float           // 1.0 - 10.0
  driftRating       Float           // 1.0 - 10.0
  mass              Int             // kg
  engineSoundType   String          // v10_screamer, v8_muscle, turbo_drift, hyper_v12, classic_v8, etc.
  defaultColor      String          @default("#E11D48")
  defaultWheels     String          @default("sport_5spoke")
  isLockedByDefault Boolean         @default(true)
  description       String
  createdAt         DateTime        @default(now())

  userCars          UserGameCar[]
  driftScores       GameDriftScore[]

  @@map("game_cars")
}

model UserGameCar {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  carKey         String
  car            GameCar   @relation(fields: [carKey], references: [key], onDelete: Cascade)
  selectedColor  String    @default("#E11D48")
  selectedWheels String    @default("sport_5spoke")
  condition      Int       @default(100) // 0 - 100%
  isFavorite     Boolean   @default(false)
  purchasedAt    DateTime  @default(now())

  @@unique([userId, carKey])
  @@map("user_game_cars")
}

model GameDriftScore {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  carKey          String
  car             GameCar   @relation(fields: [carKey], references: [key], onDelete: Cascade)
  mode            String    @default("drift") // drift, free, time_attack
  score           Int
  maxCombo        Int       @default(1)
  maxSpeedReached Int       @default(0)
  durationSeconds Int       @default(60)
  coinsAwarded    Int       @default(0)
  createdAt       DateTime  @default(now())

  @@map("game_drift_scores")
}

model DailyActivity {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String   // "YYYY-MM-DD" Asia/Tashkent
  correctAnswers   Int      @default(0)
  lessonsCompleted Int      @default(0)
  score            Int      @default(0)
  level            String   @default("NONE") // NONE, LOW, MEDIUM, HIGH
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_activities")
}

model UserAnnouncementDismissal {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcementId String   @map("announcement_id")
  dismissedAt    DateTime @default(now()) @map("dismissed_at")

  @@unique([userId, announcementId])
  @@index([userId])
  @@map("user_announcement_dismissals")
}
