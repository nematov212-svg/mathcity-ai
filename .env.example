# MathCity AI Environment Configuration Example

# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mathcity_db?schema=public"
JWT_SECRET="mathcity-ai-super-secure-jwt-secret-min32chars"
JWT_EXPIRES_IN="7d"

# AI Teacher Integration (Ziyo)
# Server-side only; never expose to frontend
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# CORS
CORS_ORIGIN="*"

# MathCity App Configuration
APP_NAME="MathCity AI"
APP_VERSION="1.0.0"
